{
  "expo": {
    "name": "beacon-games",
    "slug": "beacon-games",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/beacon-icon.png",
    "scheme": "beacongames",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/beacon-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1224",
        "foregroundImage": "./assets/images/beacon-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.allenwhun.beacongames"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/beacon-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "326f24c2-5b56-4f1e-8070-0b5f52b66044"
      }
    },
    "owner": "allenwhun"
  }
}
